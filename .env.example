# Copie para `.env.local` e preencha. Nunca commite valores reais.
# Validado por zod em src/lib/env.ts (público) e src/lib/env.server.ts (servidor).

# --- Público (embutido no bundle do cliente; nunca coloque segredos aqui) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Somente servidor ---
# Chave gratuita em https://api.nasa.gov (DEMO_KEY esgota a cota rapidamente).
NASA_API_KEY=
# Service role: só ingestão/cron. NUNCA usar o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Protege /api/cron/ingest (Authorization: Bearer <CRON_SECRET>). Mínimo 32 caracteres.
CRON_SECRET=
